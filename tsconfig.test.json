{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "vitest*.config.ts",
    "packages/**/*.test.ts",
    "packages/**/vitest*.config.ts",
    "apps/**/*.test.ts",
    "apps/**/vitest*.config.ts"
  ]
}
