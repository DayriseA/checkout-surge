{
  "name": "@checkout-surge/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./public-visitor-credential": {
      "types": "./dist/public-visitor-credential.d.ts",
      "import": "./dist/public-visitor-credential.js",
      "default": "./dist/public-visitor-credential.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --watch --config vitest.config.ts",
    "test:coverage:unit": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
