{
  "name": "@checkout-surge/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "db:migrate": "node ../../scripts/run-with-env.mjs tsx src/scripts/migrate.ts",
    "seed": "node ../../scripts/run-with-env.mjs tsx src/scripts/seed.ts",
    "test": "pnpm test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "node ../../scripts/run-with-test-env.mjs vitest run --config vitest.integration.config.ts",
    "test:db:migrate": "node ../../scripts/run-with-test-env.mjs tsx src/scripts/test-db-migrate.ts"
  },
  "dependencies": {
    "@checkout-surge/contracts": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4"
  }
}
