{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "ADMIN_DASHBOARD_PASSPHRASE",
    "ADMIN_SESSION_MAX_AGE_SECONDS",
    "ADMIN_SESSION_SECRET",
    "API_BASE_URL",
    "CONTROL_SERVICE_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "type-check:test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:api": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
