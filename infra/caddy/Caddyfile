{
	auto_https off
}

:8080 {
	encode gzip

	# Browser EventSource uses this same-origin path; only the SSE stream bypasses Next.js.
	handle /dashboard/events {
		reverse_proxy api-dashboard-edge:4000
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Checkout-Surge-Client-Id {remote_host}
			header_up X-Checkout-Surge-Client-Attestation {$ADMIN_EDGE_ATTESTATION_SECRET}
		}
	}
}
