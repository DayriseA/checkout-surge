{
  "image": "load-orchestrator",
  "guest": {
    "cpu_kind": "performance",
    "cpus": 4,
    "memory_mb": 8192
  },
  "metadata": {
    "role": "runner"
  },
  "restart": {
    "policy": "no"
  },
  "env": {
    "HOST": "::",
    "PORT": "4200",
    "LOG_LEVEL": "info",
    "API_BASE_URL": "http://checkout-surge-core.internal:4000",
    "K6_CANCELLATION_TIMEOUT_MS": "10000",
    "COMPLETION_DELIVERY_RETRY_INTERVAL_MS": "5000",
    "LOAD_ORCHESTRATOR_STATE_DIR": "/var/lib/checkout-surge/load-orchestrator"
  }
}
