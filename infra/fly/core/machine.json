{
  "guest": {
    "cpu_kind": "performance",
    "cpus": 6,
    "memory_mb": 12288
  },
  "metadata": {
    "role": "core"
  },
  "stop_config": {
    "timeout": "30s"
  },
  "volumes": [
    {
      "name": "data"
    }
  ],
  "mounts": [
    {
      "name": "data",
      "path": "/persistent",
      "volume": ""
    }
  ],
  "containers": [
    {
      "name": "postgres",
      "image": "postgres:17-alpine",
      "cmd": [
        "sh",
        "-c",
        "export PGDATA=/persistent/postgres && exec sh /fly/delayed-stop.sh INT docker-entrypoint.sh postgres -c listen_addresses=127.0.0.1"
      ],
      "env": {
        "POSTGRES_DB": "checkout_surge",
        "POSTGRES_USER": "postgres"
      },
      "secrets": [
        {
          "env_var": "POSTGRES_PASSWORD"
        }
      ],
      "files": [
        {
          "guest_path": "/fly/delayed-stop.sh",
          "local_path": "infra/fly/core/delayed-stop.sh"
        }
      ],
      "restart": {
        "policy": "on-failure"
      },
      "healthchecks": [
        {
          "name": "ready",
          "exec": {
            "command": ["pg_isready", "-h", "127.0.0.1", "-U", "postgres", "-d", "checkout_surge"]
          },
          "interval": 2,
          "timeout": 3
        }
      ]
    },
    {
      "name": "redis",
      "image": "redis:7-alpine",
      "cmd": [
        "sh",
        "-c",
        "mkdir -p /persistent/redis && cd /persistent/redis && exec sh /fly/delayed-stop.sh TERM docker-entrypoint.sh redis-server --dir /persistent/redis --appendonly yes --bind 127.0.0.1 --requirepass \"$REDIS_PASSWORD\""
      ],
      "secrets": [
        {
          "env_var": "REDIS_PASSWORD"
        }
      ],
      "files": [
        {
          "guest_path": "/fly/delayed-stop.sh",
          "local_path": "infra/fly/core/delayed-stop.sh"
        }
      ],
      "restart": {
        "policy": "on-failure"
      },
      "healthchecks": [
        {
          "name": "ready",
          "exec": {
            "command": [
              "sh",
              "-c",
              "REDISCLI_AUTH=\"$REDIS_PASSWORD\" redis-cli -h 127.0.0.1 ping | grep -q PONG"
            ]
          },
          "interval": 2,
          "timeout": 3
        }
      ]
    },
    {
      "name": "setup",
      "image": "setup",
      "env": {
        "PUBLIC_RUN_BUDGET_WINDOW_SECONDS": "86400",
        "PUBLIC_RUN_BUDGET_PER_VISITOR_MAX_STARTS": "15",
        "PUBLIC_RUN_BUDGET_GLOBAL_MAX_STARTS": "30",
        "PUBLIC_CUSTOM_MAX_TOTAL_REQUESTS": "25000",
        "PUBLIC_CUSTOM_MAX_BUYERS": "10000",
        "PUBLIC_CUSTOM_MAX_REQUESTS_PER_SECOND": "2500",
        "PUBLIC_CUSTOM_MAX_TRAFFIC_DURATION_SECONDS": "120",
        "PUBLIC_CUSTOM_MAX_TRAFFIC_START_DELAY_SECONDS": "10",
        "PUBLIC_CUSTOM_MAX_PRE_ALLOCATED_VUS": "1000",
        "PUBLIC_CUSTOM_MAX_VUS": "1000",
        "PUBLIC_CUSTOM_MAX_STARTING_STOCK": "1000",
        "PUBLIC_CUSTOM_MAX_ERP_LATENCY_MS": "2000",
        "PUBLIC_CUSTOM_MIN_ERP_MAX_TPS": "1",
        "PUBLIC_CUSTOM_MAX_ERP_MAX_TPS": "50",
        "PUBLIC_CUSTOM_MAX_ERP_ERROR_RATE": "0.25"
      },
      "secrets": [
        {
          "env_var": "DATABASE_URL"
        }
      ],
      "restart": {
        "policy": "no"
      },
      "depends_on": [
        {
          "name": "postgres",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "mock-erp",
      "image": "mock-erp",
      "env": {
        "HOST": "127.0.0.1",
        "PORT": "4100"
      },
      "secrets": [
        {
          "env_var": "DATABASE_URL"
        }
      ],
      "restart": {
        "policy": "on-failure"
      },
      "depends_on": [
        {
          "name": "setup",
          "condition": "exited_successfully"
        }
      ],
      "healthchecks": [
        {
          "name": "ready",
          "exec": {
            "command": [
              "node",
              "-e",
              "fetch('http://127.0.0.1:4100/health/ready',{signal:AbortSignal.timeout(2000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
            ]
          },
          "interval": 2,
          "timeout": 3
        }
      ]
    },
    {
      "name": "api",
      "image": "api",
      "env": {
        "HOST": "::",
        "PORT": "4000",
        "API_LISTEN_BACKLOG": "8192",
        "API_TRUSTED_PROXY_CIDRS": "127.0.0.0/8,::1/128",
        "LOAD_ORCHESTRATOR_BASE_URL": "http://checkout-surge-runner.internal:4200",
        "RUNNER_FLY_APP": "checkout-surge-runner",
        "RUNNER_MACHINE_CONFIG_FILE": "/fly/runner-machine.json",
        "RUNNER_CPUS": "8",
        "RUNNER_MEMORY_MB": "16384",
        "DEMO_MAX_BUYERS": "10000",
        "DEMO_MAX_TOTAL_REQUESTS": "100000",
        "DEMO_MAX_REQUESTS_PER_SECOND": "10000",
        "DEMO_MAX_TRAFFIC_DURATION_SECONDS": "300",
        "DEMO_MAX_TRAFFIC_START_DELAY_SECONDS": "30",
        "DEMO_MAX_PRE_ALLOCATED_VUS": "10000",
        "DEMO_MAX_VUS": "10000",
        "DEMO_MAX_ESTIMATED_OCCUPANCY_SECONDS": "600",
        "CAPACITY_CONSTANT_ARRIVAL_SOLD_OUT_PER_SECOND": "3500",
        "CAPACITY_CONSTANT_ARRIVAL_ACCEPTED_PER_SECOND": "240",
        "CAPACITY_CONSTANT_ARRIVAL_ACCEPTED_ORDER_COST": "7",
        "CAPACITY_BUYER_SPIKE_SOLD_OUT_PER_SECOND": "2600",
        "CAPACITY_BUYER_SPIKE_ACCEPTED_PER_SECOND": "240",
        "CAPACITY_VU_LATENCY_BUDGET_SECONDS": "4",
        "CORE_IDLE_STOP_ENABLED": "true",
        "WEB_ORIGIN": "https://checkout-surge-gate.fly.dev"
      },
      "secrets": [
        {
          "env_var": "DATABASE_URL"
        },
        {
          "env_var": "REDIS_URL"
        },
        {
          "env_var": "CONTROL_SERVICE_TOKEN"
        },
        {
          "env_var": "PUBLIC_CLIENT_COOKIE_SECRET"
        },
        {
          "env_var": "RUNNER_FLY_API_TOKEN"
        },
        {
          "env_var": "CORE_FLY_API_TOKEN"
        }
      ],
      "restart": {
        "policy": "on-failure"
      },
      "depends_on": [
        {
          "name": "setup",
          "condition": "exited_successfully"
        },
        {
          "name": "redis",
          "condition": "healthy"
        }
      ],
      "healthchecks": [
        {
          "name": "ready",
          "exec": {
            "command": [
              "node",
              "-e",
              "fetch('http://127.0.0.1:4000/health/ready',{signal:AbortSignal.timeout(2000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
            ]
          },
          "interval": 2,
          "timeout": 3
        }
      ]
    },
    {
      "name": "worker",
      "image": "worker",
      "env": {
        "HEALTH_HOST": "127.0.0.1",
        "HEALTH_PORT": "4300",
        "MOCK_ERP_BASE_URL": "http://127.0.0.1:4100"
      },
      "secrets": [
        {
          "env_var": "DATABASE_URL"
        },
        {
          "env_var": "REDIS_URL"
        }
      ],
      "restart": {
        "policy": "on-failure"
      },
      "depends_on": [
        {
          "name": "setup",
          "condition": "exited_successfully"
        },
        {
          "name": "redis",
          "condition": "healthy"
        },
        {
          "name": "mock-erp",
          "condition": "healthy"
        }
      ],
      "healthchecks": [
        {
          "name": "ready",
          "exec": {
            "command": [
              "node",
              "-e",
              "fetch('http://127.0.0.1:4300/health/ready',{signal:AbortSignal.timeout(2000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
            ]
          },
          "interval": 2,
          "timeout": 3
        }
      ]
    },
    {
      "name": "web",
      "image": "web",
      "cmd": ["sh", "-c", "HOSTNAME=127.0.0.1 exec node apps/web/server.js"],
      "env": {
        "PORT": "3000",
        "API_BASE_URL": "http://127.0.0.1:4000",
        "WEB_ORIGIN": "https://checkout-surge-gate.fly.dev"
      },
      "secrets": [
        {
          "env_var": "CONTROL_SERVICE_TOKEN"
        },
        {
          "env_var": "ADMIN_DASHBOARD_PASSPHRASE"
        },
        {
          "env_var": "ADMIN_SESSION_SECRET"
        },
        {
          "env_var": "PUBLIC_CLIENT_COOKIE_SECRET"
        }
      ],
      "restart": {
        "policy": "on-failure"
      },
      "depends_on": [
        {
          "name": "api",
          "condition": "healthy"
        },
        {
          "name": "mock-erp",
          "condition": "healthy"
        }
      ],
      "healthchecks": [
        {
          "name": "ready",
          "exec": {
            "command": [
              "node",
              "-e",
              "fetch('http://127.0.0.1:3000/health',{signal:AbortSignal.timeout(2000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
            ]
          },
          "interval": 2,
          "timeout": 5
        }
      ]
    },
    {
      "name": "caddy",
      "image": "caddy:2-alpine",
      "files": [
        {
          "guest_path": "/etc/caddy/Caddyfile",
          "local_path": "infra/caddy/Caddyfile.fly"
        }
      ],
      "restart": {
        "policy": "on-failure"
      },
      "depends_on": [
        {
          "name": "api",
          "condition": "healthy"
        },
        {
          "name": "web",
          "condition": "healthy"
        }
      ],
      "healthchecks": [
        {
          "name": "ready",
          "exec": {
            "command": ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/health"]
          },
          "interval": 2,
          "timeout": 5
        }
      ]
    }
  ]
}
