{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "type-check": "next typegen && tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "dev": "node ../../scripts/run-with-env.mjs next dev -p 3000",
    "test": "pnpm test:unit",
    "test:unit": "node ../../scripts/run-with-test-env.mjs vitest run --config vitest.config.ts",
    "test:unit:watch": "node ../../scripts/run-with-test-env.mjs vitest --watch --config vitest.config.ts",
    "test:coverage:unit": "node ../../scripts/run-with-test-env.mjs vitest run --config vitest.config.ts --coverage",
    "test:focused:proxy": "node ../../scripts/run-with-test-env.mjs vitest run --config vitest.config.ts test/admin-control-proxy.test.ts test/api-read-fallback.test.ts"
  },
  "dependencies": {
    "@checkout-surge/contracts": "workspace:*",
    "@checkout-surge/logger": "workspace:*",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.1"
  }
}
