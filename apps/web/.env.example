# Web dashboard host-native defaults.
PORT=3000
HOST=0.0.0.0

# Server-side service calls from the dashboard app.
API_BASE_URL=http://localhost:4000
MOCK_ERP_BASE_URL=http://localhost:4100
LOAD_ORCHESTRATOR_BASE_URL=http://localhost:4200
WORKER_HEALTH_BASE_URL=http://localhost:4300
WEB_BASE_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8080

# Browser realtime normally uses same-origin /dashboard/events through Caddy.
# Debug only: set this to a full SSE endpoint when opening the web app directly.
# NEXT_PUBLIC_DASHBOARD_EVENTS_URL=http://localhost:4000/dashboard/events

# Dashboard control and visitor sessions. Generate distinct values in your private .env;
# never reuse the admin-session and public-visitor HMAC secrets.
CONTROL_SERVICE_TOKEN=
ADMIN_DASHBOARD_PASSPHRASE=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_MAX_AGE_SECONDS=28800
ADMIN_LOGIN_CLIENT_ATTEMPTS=5
ADMIN_LOGIN_GLOBAL_ATTEMPTS=20
ADMIN_LOGIN_WINDOW_SECONDS=60
# Required in production behind Caddy. Direct development requests use the shared unknown bucket.
ADMIN_EDGE_ATTESTATION_SECRET=
PUBLIC_CLIENT_COOKIE_SECRET=
