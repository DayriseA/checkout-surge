# Worker host-native defaults.
LOG_LEVEL=info
HEALTH_PORT=4300
HEALTH_HOST=0.0.0.0

# Worker-owned infrastructure clients.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/checkout_surge
REDIS_URL=redis://localhost:6379
WORKER_POSTGRES_POOL_MAX=10

# Downstream ERP client.
MOCK_ERP_BASE_URL=http://localhost:4100
ERP_REQUEST_TIMEOUT_MS=2000
ERP_CIRCUIT_FAILURE_THRESHOLD=5
ERP_CIRCUIT_RESET_TIMEOUT_MS=10000

# Queue consumer defaults.
# BullMQ process-wide execution ceiling; must be at least the accepted-run hard cap (10).
ORDER_PROCESS_CONCURRENCY=10
NOTIFICATION_RECORD_CONCURRENCY=5
NOTIFICATION_RECOVERY_SCAN_INTERVAL_MS=1000
NOTIFICATION_RECOVERY_BATCH_SIZE=100
ORDER_DISPATCH_SCAN_INTERVAL_MS=1000
ORDER_DISPATCH_BATCH_SIZE=100
ORDER_DISPATCH_MINIMUM_QUEUED_AGE_MS=1000
ORDER_RECOVERY_SCAN_INTERVAL_MS=1000
ORDER_RECOVERY_BATCH_SIZE=100
# Must exceed the configured ERP request timeout and expected DB/BullMQ handoff latency.
ORDER_RECOVERY_LEASE_MS=30000
ORDER_RECOVERY_MAX_ATTEMPTS=100
