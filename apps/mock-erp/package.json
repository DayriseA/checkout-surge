{
  "name": "mock-erp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "dev": "node ../../scripts/run-with-env.mjs tsx watch src/index.ts",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "node ../../scripts/run-with-test-env.mjs vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@checkout-surge/contracts": "workspace:*",
    "@checkout-surge/db": "workspace:*",
    "@checkout-surge/logger": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "vitest": "^4.1.9"
  }
}
