# Mock ERP host-native defaults.
PORT=4100
HOST=0.0.0.0
LOG_LEVEL=info
CONTROL_SERVICE_TOKEN=change-me-shared-control-token

# Global fallback chaos behavior.
LATENCY_MS=0
MAX_TPS=100
ERROR_RATE=0
FORCED_OUTAGE=false

# Admin chaos safety caps.
ADMIN_MAX_LATENCY_MS=5000
ADMIN_MIN_MAX_TPS=1
ADMIN_MAX_ERROR_RATE=1
ADMIN_ALLOW_FORCED_OUTAGE=true
