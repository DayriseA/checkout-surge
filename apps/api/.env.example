# API gateway host-native defaults.
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# API-owned infrastructure.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/checkout_surge
REDIS_URL=redis://localhost:6379
API_POSTGRES_POOL_MAX=10

# Control and browser-facing origin policy.
CONTROL_SERVICE_TOKEN=change-me-shared-control-token
WEB_ORIGIN=http://localhost:8080
API_LISTEN_BACKLOG=8192

# Reservation hot-path defaults.
RESERVATION_HOLD_MINUTES=15
IDEMPOTENCY_TTL_SECONDS=1800
PENDING_PERSISTENCE_RETRY_AFTER_SECONDS=30
ORDER_PROCESS_MAX_ATTEMPTS=4
ORDER_PROCESS_BACKOFF_BASE_MS=500

# Demo run hard caps.
DEMO_MAX_BUYERS=100000
DEMO_MAX_TOTAL_REQUESTS=100000
DEMO_MAX_REQUESTS_PER_SECOND=10000
DEMO_MAX_TRAFFIC_DURATION_SECONDS=300
DEMO_MAX_TRAFFIC_START_DELAY_SECONDS=30
DEMO_MAX_PRE_ALLOCATED_VUS=10000
DEMO_MAX_VUS=10000
DEMO_RUN_DRAIN_TIMEOUT_SECONDS=300
DEMO_RUN_FINALIZATION_POLL_INTERVAL_SECONDS=5

# Public run budget defaults.
PUBLIC_RUN_BUDGET_WINDOW_SECONDS=300
PUBLIC_RUN_BUDGET_PER_VISITOR_MAX_STARTS=2
PUBLIC_RUN_BUDGET_GLOBAL_MAX_STARTS=6

# Public custom run caps.
PUBLIC_CUSTOM_MAX_TOTAL_REQUESTS=10000
PUBLIC_CUSTOM_MAX_BUYERS=10000
PUBLIC_CUSTOM_MAX_REQUESTS_PER_SECOND=1000
PUBLIC_CUSTOM_MAX_TRAFFIC_DURATION_SECONDS=120
PUBLIC_CUSTOM_MAX_TRAFFIC_START_DELAY_SECONDS=10
PUBLIC_CUSTOM_MAX_PRE_ALLOCATED_VUS=1000
PUBLIC_CUSTOM_MAX_VUS=1000
PUBLIC_CUSTOM_MAX_STARTING_STOCK=1000
PUBLIC_CUSTOM_MAX_ERP_LATENCY_MS=2000
PUBLIC_CUSTOM_MIN_ERP_MAX_TPS=1
PUBLIC_CUSTOM_MAX_ERP_MAX_TPS=100
PUBLIC_CUSTOM_MAX_ERP_ERROR_RATE=0.25
