# API gateway host-native defaults.
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# API-owned infrastructure.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/checkout_surge
REDIS_URL=redis://localhost:6379
API_POSTGRES_POOL_MAX=10
API_READINESS_TIMEOUT_MS=2000

# Control and browser-facing origin policy.
CONTROL_SERVICE_TOKEN=
PUBLIC_CLIENT_COOKIE_SECRET=
WEB_ORIGIN=http://localhost:8080
API_LISTEN_BACKLOG=8192
API_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,172.30.0.2/32

# Public dashboard availability controls (positive integers only). Recovery admission is process-local.
DASHBOARD_MAX_SSE_CLIENTS=80
DASHBOARD_MAX_SSE_CLIENTS_PER_SOURCE=6
DASHBOARD_SSE_MAX_BUFFERED_FRAMES=32
DASHBOARD_SSE_MAX_BUFFERED_BYTES=262144
DASHBOARD_SSE_RETRY_AFTER_SECONDS=10
DASHBOARD_RECOVERY_MAX_CONCURRENT=3
DASHBOARD_RECOVERY_GLOBAL_MAX_REQUESTS=60
DASHBOARD_RECOVERY_PER_SOURCE_MAX_REQUESTS=12
DASHBOARD_RECOVERY_WINDOW_SECONDS=60
DASHBOARD_RECOVERY_RETRY_AFTER_SECONDS=10
DASHBOARD_RECOVERY_TIMEOUT_MS=5000

# Reservation hot-path defaults.
RESERVATION_HOLD_MINUTES=15
IDEMPOTENCY_TTL_SECONDS=1800
PENDING_PERSISTENCE_RETRY_AFTER_SECONDS=30

# API startup deployment ceilings. These are overlaid onto the durable public policy on every boot.
DEMO_MAX_BUYERS=100000
DEMO_MAX_TOTAL_REQUESTS=100000
DEMO_MAX_REQUESTS_PER_SECOND=10000
DEMO_MAX_TRAFFIC_DURATION_SECONDS=300
DEMO_MAX_TRAFFIC_START_DELAY_SECONDS=30
DEMO_MAX_PRE_ALLOCATED_VUS=10000
DEMO_MAX_VUS=10000
DEMO_MAX_ESTIMATED_OCCUPANCY_SECONDS=600

# Host-dependent estimator allowances. The defaults were calibrated on a developer dev container
# (Docker 29.6.1-1 on Linux/WSL2, 16 visible CPUs, 7,637 MiB RAM, one worker).
# They only make the admission estimate more or less pessimistic and never affect accounting.
# Re-run the calibration procedure in docs/estimator_calibration.md on the target host before relying on them.
ESTIMATOR_JOB_OVERHEAD_MS=130
ESTIMATOR_SETTLEMENT_OVERHEAD_SECONDS=15
ESTIMATOR_TRANSIENT_ERROR_DEMAND_MARGIN=1.25
ESTIMATOR_EXCESS_ATTEMPT_PAUSE_SECONDS=1

# Measured capacity per connection mode, for capacity-aware admission and the default VUs of
# constant-arrival runs (VUs = rate x latency budget). The defaults were measured on a 4 vCPU /
# 16 GB cloud VM running the whole stack. Re-measure on the target host with docs/capacity_measurement.md.
CAPACITY_CONSTANT_ARRIVAL_SOLD_OUT_PER_SECOND=3000
CAPACITY_CONSTANT_ARRIVAL_ACCEPTED_PER_SECOND=195
CAPACITY_CONSTANT_ARRIVAL_ACCEPTED_ORDER_COST=21
CAPACITY_BUYER_SPIKE_SOLD_OUT_PER_SECOND=1150
CAPACITY_BUYER_SPIKE_ACCEPTED_PER_SECOND=155
CAPACITY_VU_LATENCY_BUDGET_SECONDS=4

DEMO_RUN_FINALIZATION_POLL_INTERVAL_SECONDS=5
