{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "dev": "node ../../scripts/run-with-env.mjs tsx watch src/index.ts",
    "test": "pnpm test:unit && pnpm test:api",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:coverage:unit": "vitest run --config vitest.unit.config.ts --coverage",
    "test:api": "node ../../scripts/run-with-test-env.mjs vitest run --config vitest.api.config.ts",
    "test:coverage:api": "node ../../scripts/run-with-test-env.mjs vitest run --config vitest.api.config.ts --coverage"
  },
  "dependencies": {
    "@checkout-surge/contracts": "workspace:*",
    "@checkout-surge/db": "workspace:*",
    "@checkout-surge/logger": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "bullmq": "^5.79.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "vitest": "^4.1.9"
  }
}
