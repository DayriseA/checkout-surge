# Shared host-native defaults. Copy to .env for local overrides.
NODE_ENV=development
LOG_LEVEL=info

# Development infrastructure
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/checkout_surge
REDIS_URL=redis://localhost:6379

# Shared service trust and dashboard sessions. Generate distinct values in your private .env;
# these blank entries are documentation only and are never safe runtime credentials.
CONTROL_SERVICE_TOKEN=
ADMIN_DASHBOARD_PASSPHRASE=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_MAX_AGE_SECONDS=28800
ADMIN_LOGIN_CLIENT_ATTEMPTS=5
ADMIN_LOGIN_GLOBAL_ATTEMPTS=20
ADMIN_LOGIN_WINDOW_SECONDS=60
# Required in production behind Caddy. Host-native development has no trusted edge and uses the shared unknown bucket.
ADMIN_EDGE_ATTESTATION_SECRET=
PUBLIC_CLIENT_COOKIE_SECRET=

# Host-native service URLs
API_BASE_URL=http://localhost:4000
MOCK_ERP_BASE_URL=http://localhost:4100
LOAD_ORCHESTRATOR_BASE_URL=http://localhost:4200
WORKER_HEALTH_BASE_URL=http://localhost:4300
WEB_BASE_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8080

# Browser realtime normally uses the dashboard origin at /dashboard/events.
# Debug only: set this to a full SSE endpoint when bypassing the Caddy proxy.
# NEXT_PUBLIC_DASHBOARD_EVENTS_URL=http://localhost:4000/dashboard/events

# Shared reservation defaults
RESERVATION_HOLD_MINUTES=15
IDEMPOTENCY_TTL_SECONDS=1800
PENDING_PERSISTENCE_RETRY_AFTER_SECONDS=30
