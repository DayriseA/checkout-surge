# Shared host-native defaults. Copy to .env for local overrides.
NODE_ENV=development
LOG_LEVEL=info

# Development infrastructure
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/checkout_surge
REDIS_URL=redis://localhost:6379

# Shared service trust and dashboard sessions. Generate distinct values in your private .env;
# these blank entries are documentation only and are never safe runtime credentials.
CONTROL_SERVICE_TOKEN=
ADMIN_DASHBOARD_PASSPHRASE=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_MAX_AGE_SECONDS=28800
ADMIN_LOGIN_CLIENT_ATTEMPTS=5
ADMIN_LOGIN_GLOBAL_ATTEMPTS=20
ADMIN_LOGIN_WINDOW_SECONDS=60
# Required in production behind Caddy. Host-native development has no trusted edge and uses the shared unknown bucket.
ADMIN_EDGE_ATTESTATION_SECRET=
PUBLIC_CLIENT_COOKIE_SECRET=

# Host-native service URLs
API_BASE_URL=http://localhost:4000
MOCK_ERP_BASE_URL=http://localhost:4100
LOAD_ORCHESTRATOR_BASE_URL=http://localhost:4200
WORKER_HEALTH_BASE_URL=http://localhost:4300
WEB_BASE_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8080

# Shared reservation defaults
RESERVATION_HOLD_MINUTES=15
IDEMPOTENCY_TTL_SECONDS=1800
PENDING_PERSISTENCE_RETRY_AFTER_SECONDS=30

# API-owned deployment ceilings and finalization behavior. Changes apply on API restart.
# DEMO_MAX_* values are intentionally not passed to runtime-setup or persisted in PostgreSQL.
DEMO_MAX_BUYERS=100000
DEMO_MAX_TOTAL_REQUESTS=100000
DEMO_MAX_REQUESTS_PER_SECOND=10000
DEMO_MAX_TRAFFIC_DURATION_SECONDS=300
DEMO_MAX_TRAFFIC_START_DELAY_SECONDS=30
DEMO_MAX_PRE_ALLOCATED_VUS=10000
DEMO_MAX_VUS=10000
DEMO_RUN_DRAIN_TIMEOUT_SECONDS=300
DEMO_RUN_FINALIZATION_POLL_INTERVAL_SECONDS=5

# Service control-plane response bounds. Readiness remains below Compose's 3-second probe timeout.
API_READINESS_TIMEOUT_MS=2000
MOCK_ERP_READINESS_TIMEOUT_MS=2000
DASHBOARD_RECOVERY_TIMEOUT_MS=5000

# runtime-setup first-seed defaults for the PostgreSQL-owned mutable public policy.
# After bootstrap, change these values through the admin policy UI/API. Setup reruns preserve edits.
PUBLIC_RUN_BUDGET_WINDOW_SECONDS=300
PUBLIC_RUN_BUDGET_PER_VISITOR_MAX_STARTS=2
PUBLIC_RUN_BUDGET_GLOBAL_MAX_STARTS=6
PUBLIC_CUSTOM_MAX_TOTAL_REQUESTS=10000
PUBLIC_CUSTOM_MAX_BUYERS=10000
PUBLIC_CUSTOM_MAX_REQUESTS_PER_SECOND=1000
PUBLIC_CUSTOM_MAX_TRAFFIC_DURATION_SECONDS=120
PUBLIC_CUSTOM_MAX_TRAFFIC_START_DELAY_SECONDS=10
PUBLIC_CUSTOM_MAX_PRE_ALLOCATED_VUS=1000
PUBLIC_CUSTOM_MAX_VUS=1000
PUBLIC_CUSTOM_MAX_STARTING_STOCK=1000
PUBLIC_CUSTOM_MAX_ERP_LATENCY_MS=2000
PUBLIC_CUSTOM_MIN_ERP_MAX_TPS=1
PUBLIC_CUSTOM_MAX_ERP_MAX_TPS=100
PUBLIC_CUSTOM_MAX_ERP_ERROR_RATE=0.25
