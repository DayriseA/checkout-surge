# Shared host-native defaults. Copy to .env for local overrides.
NODE_ENV=development
LOG_LEVEL=info

# Development infrastructure
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/checkout_surge
REDIS_URL=redis://localhost:6379

# Shared service trust and dashboard sessions
CONTROL_SERVICE_TOKEN=change-me-shared-control-token
ADMIN_DASHBOARD_PASSPHRASE=change-me-admin-passphrase
ADMIN_SESSION_SECRET=change-me-admin-session-secret
ADMIN_SESSION_MAX_AGE_SECONDS=28800
PUBLIC_CLIENT_COOKIE_SECRET=change-me-public-client-cookie-secret

# Host-native service URLs
API_BASE_URL=http://localhost:4000
MOCK_ERP_BASE_URL=http://localhost:4100
LOAD_ORCHESTRATOR_BASE_URL=http://localhost:4200
WORKER_HEALTH_BASE_URL=http://localhost:4300
WEB_BASE_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8080

# Shared reservation defaults
RESERVATION_HOLD_MINUTES=15
IDEMPOTENCY_TTL_SECONDS=1800
PENDING_PERSISTENCE_RETRY_AFTER_SECONDS=30
